{
  "id": "niri-scale-toggle",
  "name": "Niri Scale Toggle",
  "version": "1.2.4",
  "minNoctaliaVersion": "1.0.0",
  "author": "edellingham",
  "license": "MIT",
  "description": "Quick toggle for screen scale sizes in Niri. Perfect for accessibility and evening viewing comfort.",
  "repository": "https://github.com/edellingham/noctalia-niri-scale-toggle",
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "tags": [
    "Bar",
    "System",
    "Scale",
    "Accessibility",
    "Niri"
  ],
  "metadata": {
    "defaultSettings": {
      "scales": [1.0, 1.25, 1.5, 1.75, 2.0],
      "output": "eDP-1"
    }
  }
}
